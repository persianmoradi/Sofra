---
// A generated top-down plate, unique per dish (seeded by slug). No photos needed.
const { seed, size = 120 } = Astro.props as { seed: string; size?: number };

function rng(s: string) {
  let h = 1779033703 ^ s.length;
  for (let i = 0; i < s.length; i++) {
    h = Math.imul(h ^ s.charCodeAt(i), 3432918353);
    h = (h << 13) | (h >>> 19);
  }
  let a = h;
  return () => {
    a = (a + 0x6d2b79f5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
const r = rng(seed);
const sets = [
  ['#a8431f', '#d9772b', '#e9b44c', '#5f7f3a', '#f3e6c8'],
  ['#4f7a3a', '#8fb04a', '#d8e39a', '#f3e6c8', '#b8742a'],
  ['#f3e6c8', '#e8c97a', '#c98b3a', '#7a9a45', '#b5472b'],
  ['#5a2d1a', '#8a4b2a', '#c8452d', '#e9b44c', '#f3e6c8'],
];
const set = sets[Math.floor(r() * sets.length)];
const pick = () => set[Math.floor(r() * set.length)];
const blobs = Array.from({ length: 12 }, () => {
  const a = r() * Math.PI * 2, d = Math.sqrt(r()) * 44;
  return { x: 100 + Math.cos(a) * d, y: 100 + Math.sin(a) * d, rx: 7 + r() * 11, ry: 6 + r() * 10, rot: r() * 180, c: pick() };
});
const flecks = Array.from({ length: 8 }, () => {
  const a = r() * Math.PI * 2, d = Math.sqrt(r()) * 52;
  return { x: 100 + Math.cos(a) * d, y: 100 + Math.sin(a) * d, rot: r() * 180 };
});
---

<svg class="plate" viewBox="0 0 200 200" width={size} height={size} aria-hidden="true" focusable="false">
  <circle class="rim" cx="100" cy="100" r="96" />
  <circle class="ring" cx="100" cy="100" r="88" />
  <circle class="dish" cx="100" cy="100" r="76" />
  <circle cx="100" cy="100" r="56" fill={set[0]} opacity="0.95" />
  {blobs.map((b) => <ellipse cx={b.x} cy={b.y} rx={b.rx} ry={b.ry} fill={b.c} opacity="0.92" transform={`rotate(${b.rot} ${b.x} ${b.y})`} />)}
  {flecks.map((f) => <ellipse cx={f.x} cy={f.y} rx="5" ry="2" fill="#4f8a3a" transform={`rotate(${f.rot} ${f.x} ${f.y})`} />)}
  <circle cx="80" cy="78" r="9" fill="#fff" opacity="0.18" />
  <circle cx="122" cy="118" r="5" fill="#fff" opacity="0.14" />
</svg>
